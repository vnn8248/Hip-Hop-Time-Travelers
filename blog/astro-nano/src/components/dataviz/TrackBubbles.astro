---
import "@styles/dataviz.css";

export interface Props {
  album: string;
  artist: string;
}

const { album, artist } = Astro.props;
---

<div class="dataviz not-prose" data-component="track-bubbles" data-album={album}>
  <div class="dv-controls" role="group" aria-label="Group tracks by">
    <button type="button" data-mode="none" class="active">All Tracks</button>
    <button type="button" data-mode="producer">By Producer</button>
    <button type="button" data-mode="mixer">By Mixer</button>
  </div>

  <div class="dv-panel">
    <svg class="dv-chart" viewBox="0 0 900 560" aria-label="Album tracks sized by Spotify play count"></svg>

    <div class="dv-hover-info">
      <p class="dv-hover-info-hint">{artist} — {album}</p>
      <div class="dv-track-list"></div>
    </div>

    <div class="dv-credits" hidden>
      <button type="button" class="dv-credits-close" aria-label="Close credits">&times;</button>
      <div class="dv-credits-body"></div>
    </div>
  </div>

  <div class="dv-legend"></div>
  <p class="dv-hint">Hover a circle to reveal it on the tracklist, click it for the full credit list.</p>
</div>

<script>
  import * as d3 from "d3";

  const W = 900;
  const H = 560;

  // Fixed categorical order, anchored to the album-cover palette (brand
  // sage green first). "Unknown" always gets the neutral, never a hue.
  const SERIES = ["#597E5D", "#4A8FD6", "#B87F1C", "#29A67D", "#8860E0"];
  const NEUTRAL = "#96A69A";

  type Credit = {
    role: string;
    role_detail: string;
    person: string;
    is_primary: boolean;
  };

  type Track = {
    id: string;
    name: string;
    trackNumber: number;
    producer: string;
    mixer: string;
    playCount: number;
    credits: Credit[];
    x?: number;
    y?: number;
  };

  function humanize(s: string) {
    return s
      .split("_")
      .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
      .join(" ");
  }

  function buildPalette(tracks: Track[], key: "producer" | "mixer") {
    const names = [...new Set(tracks.map((d) => d[key]))];
    const named = names.filter((n) => n !== "Unknown");
    const p: Record<string, string> = {};
    named.forEach((n, i) => (p[n] = SERIES[i % SERIES.length]));
    if (names.includes("Unknown")) p["Unknown"] = NEUTRAL;
    return p;
  }

  function renderCredits(root: HTMLElement, track: Track) {
    const panel = root.querySelector<HTMLDivElement>(".dv-credits")!;
    const body = panel.querySelector<HTMLDivElement>(".dv-credits-body")!;

    const roleOrder = ["producer", "writer", "instrumentalist", "recorder", "mixer"];
    const grouped = d3.group(track.credits, (c) => c.role);
    const roles = [...grouped.keys()].sort(
      (a, b) => roleOrder.indexOf(a) - roleOrder.indexOf(b),
    );

    let html = `<p class="dv-credits-title">${track.name}</p>`;
    if (roles.length === 0) {
      html += `<p class="dv-empty">No credit data available.</p>`;
    }
    for (const role of roles) {
      html += `<h4>${humanize(role)}</h4><ul>`;
      for (const c of grouped.get(role) ?? []) {
        const detail =
          c.role_detail && c.role_detail !== role
            ? ` <span class="dv-role-detail">(${humanize(c.role_detail)})</span>`
            : "";
        html += `<li>${c.person}${detail}</li>`;
      }
      html += `</ul>`;
    }
    body.innerHTML = html;
    panel.hidden = false;
  }

  function initTrackBubbles(root: HTMLElement) {
    const album = root.dataset.album;
    const svg = d3.select(root.querySelector<SVGSVGElement>(".dv-chart")!);
    const nodesG = svg.append("g");
    const labelsG = svg.append("g");
    const trackListEl = root.querySelector<HTMLDivElement>(".dv-track-list")!;
    const creditsPanel = root.querySelector<HTMLDivElement>(".dv-credits")!;
    const creditsClose = root.querySelector<HTMLButtonElement>(".dv-credits-close")!;

    let currentMode: "none" | "producer" | "mixer" = "none";
    let tracks: Track[] = [];
    let radius: d3.ScaleSqrt<number, number> | null = null;
    let palette: Record<string, Record<string, string>> = {};
    const revealed = new Set<string>();
    let activeCreditsId: string | null = null;

    function closeCredits() {
      creditsPanel.hidden = true;
      nodesG.selectAll("circle.dv-node-active").classed("dv-node-active", false);
      activeCreditsId = null;
    }

    function toggleCredits(circleEl: Element, track: Track) {
      if (activeCreditsId === track.id) {
        closeCredits();
        return;
      }
      nodesG.selectAll("circle.dv-node-active").classed("dv-node-active", false);
      renderCredits(root, track);
      d3.select(circleEl).classed("dv-node-active", true);
      activeCreditsId = track.id;
    }

    creditsClose.addEventListener("click", closeCredits);

    // A "reveal the tracklist" mini-game: one row per track, in album order,
    // blank until that track's bubble has been hovered at least once.
    function initTrackList(allTracks: Track[]) {
      const ordered = [...allTracks].sort((a, b) => a.trackNumber - b.trackNumber);
      trackListEl.innerHTML = "";
      ordered.forEach((t) => {
        const row = document.createElement("div");
        row.className = "dv-track-row";
        row.dataset.trackId = t.id;
        row.innerHTML = `<span class="dv-track-num">${String(t.trackNumber).padStart(2, "0")}</span><span class="dv-track-slot">···</span>`;
        trackListEl.appendChild(row);
      });
    }

    function revealTrack(track: Track) {
      if (revealed.has(track.id)) return;
      const row = trackListEl.querySelector<HTMLDivElement>(`[data-track-id="${track.id}"]`);
      if (!row) return;
      revealed.add(track.id);
      row.classList.add("revealed");
      row.querySelector(".dv-track-slot")!.outerHTML =
        `<span class="dv-track-slot"><b>${track.name}</b><br>Plays: ${track.playCount.toLocaleString()}</span>`;
    }

    function highlightTrack(track: Track, on: boolean) {
      const row = trackListEl.querySelector<HTMLDivElement>(`[data-track-id="${track.id}"]`);
      row?.classList.toggle("current", on);
      if (on) row?.scrollIntoView({ block: "nearest" });
    }

    fetch(`/data/${album}/output/album_data_viz_${album}.json`)
      .then((res) => res.json())
      .then((recs) => {
        tracks = recs.map((d: any) => ({
          id: d.spotify_track_id,
          name: d.track_name,
          trackNumber: d.track_number,
          producer: d.primary_producer || "Unknown",
          mixer: d.primary_mixer || "Unknown",
          playCount: d.play_count,
          credits: d.credits,
        }));

        initTrackList(tracks);

        radius = d3
          .scaleSqrt()
          .domain(d3.extent(tracks, (d) => d.playCount) as [number, number])
          .range([12, 110]);

        palette = {
          producer: buildPalette(tracks, "producer"),
          mixer: buildPalette(tracks, "mixer"),
          none: { all: SERIES[0] },
        };

        render(currentMode);
      })
      .catch((err) => {
        console.error(err);
        root.querySelector(".dv-panel")!.innerHTML =
          '<p class="dv-error">Couldn\'t load track data.</p>';
      });

    // Circles are drawn at their exact radius() value (see render() below),
    // not a value/sum-derived one, so the pack layout has to be told the
    // real radii via .radius() - otherwise it spaces nodes for whatever
    // radius its own sum-based math would produce, which no longer matches
    // what actually gets drawn once bubbles are sized independently, and
    // they'd overlap. .radius() packs don't force-fit to .size(); center the
    // result using the pack's own computed enclosing circle instead.
    function packCluster(items: Track[], boxW: number, boxH: number, padding: number) {
      const pack = d3
        .pack<Track>()
        .size([boxW, boxH])
        .padding(padding)
        .radius((d: any) => radius!(d.data.playCount));
      const root = d3.hierarchy<{ children: Track[] }>({ children: items });
      pack(root as any);
      return root as any;
    }

    function computeLayout(mode: "none" | "producer" | "mixer") {
      if (mode === "none") {
        const box = Math.min(W, H) - 40;
        const root = packCluster(tracks, box, box, 4);
        const offsetX = W / 2 - root.x;
        const offsetY = H / 2 - root.y;
        return {
          nodes: root
            .leaves()
            .map((l: any) => ({ ...l.data, x: l.x + offsetX, y: l.y + offsetY })),
          groups: [] as string[],
          cols: 1,
          cellW: W,
          cellH: H,
        };
      }
      const groups = d3.groups(tracks, (d) => d[mode]);
      const cols = Math.ceil(Math.sqrt(groups.length));
      const rows = Math.ceil(groups.length / cols);
      const cellW = W / cols;
      const cellH = (H - 30) / rows;
      const out: Track[] = [];
      groups.forEach(([, items], i) => {
        const cx = (i % cols) * cellW + cellW / 2;
        const cy = 30 + Math.floor(i / cols) * cellH + cellH / 2;
        const root = packCluster(items as Track[], cellW - 20, cellH - 30, 4);
        const offsetX = cx - root.x;
        const offsetY = cy - root.y;
        root.leaves().forEach((l: any) => {
          out.push({ ...l.data, x: l.x + offsetX, y: l.y + offsetY });
        });
      });
      return { nodes: out, groups: groups.map((g) => g[0] as string), cols, cellW, cellH };
    }

    function render(mode: "none" | "producer" | "mixer") {
      const layout = computeLayout(mode);
      const nodes = layout.nodes;

      labelsG.selectAll(".dv-group-label").remove();
      if (mode !== "none") {
        layout.groups.forEach((g, i) => {
          const row = Math.floor(i / layout.cols);
          const cx = (i % layout.cols) * layout.cellW + layout.cellW / 2;
          const cy = 30 + row * layout.cellH + 12;
          labelsG
            .append("text")
            .attr("class", "dv-group-label")
            .attr("x", cx)
            .attr("y", cy)
            .attr("text-anchor", "middle")
            .text(g);
        });
      }

      const sel = nodesG.selectAll<SVGGElement, Track>("g.dv-node-g").data(nodes, (d: any) => d.id);

      const enter = sel
        .enter()
        .append("g")
        .attr("class", "dv-node-g")
        .attr("transform", (d) => `translate(${d.x},${d.y})`);

      enter
        .append("circle")
        .attr("class", "dv-node")
        .attr("r", (d) => radius!(d.playCount))
        .attr("fill", (d) => palette[mode][(d as any)[mode] ?? "all"] || "#5B564A")
        // stagger the wobble per-bubble (keyed to track id, stable across
        // mode switches) so the cluster pulses like it's alive, not in lockstep
        .style("animation-delay", () => `-${(Math.random() * 2.6).toFixed(2)}s`)
        .style("animation-duration", () => `${(1.8 + Math.random() * 1.4).toFixed(2)}s`);

      const merged = enter.merge(sel as any);

      merged
        .on("mouseenter", (event, d) => {
          revealTrack(d);
          highlightTrack(d, true);
          // permanent glow so the user can see, at a glance, which bubbles
          // they've already hovered (revealed on the tracklist to the left)
          d3.select(event.currentTarget).select("circle").classed("dv-node-revealed", true);
        })
        .on("mouseleave", (_event, d) => highlightTrack(d, false))
        .on("click", (event, d) => {
          const circle = d3.select(event.currentTarget).select("circle").node() as Element;
          toggleCredits(circle, d);
        })
        .transition()
        .duration(750)
        .ease(d3.easeCubicInOut)
        .attr("transform", (d) => `translate(${d.x},${d.y})`);

      merged
        .select("circle")
        .transition()
        .duration(750)
        .ease(d3.easeCubicInOut)
        .attr("r", (d) => radius!(d.playCount))
        .attr("fill", (d) => palette[mode][(d as any)[mode] ?? "all"] || "#5B564A");

      sel.exit().remove();
      renderLegend(mode);
    }

    function renderLegend(mode: "none" | "producer" | "mixer") {
      const entries = Object.entries(palette[mode] || {});
      const legend = root.querySelector<HTMLDivElement>(".dv-legend")!;
      legend.innerHTML = "";
      entries.forEach(([key, color]) => {
        const item = document.createElement("span");
        const swatch = document.createElement("span");
        swatch.className = "dv-swatch";
        swatch.style.background = color;
        item.appendChild(swatch);
        item.append(key === "all" ? "All tracks" : key);
        legend.appendChild(item);
      });
    }

    root.querySelectorAll<HTMLButtonElement>(".dv-controls button").forEach((btn) => {
      btn.addEventListener("click", () => {
        const mode = btn.dataset.mode as "none" | "producer" | "mixer";
        currentMode = mode;
        root
          .querySelectorAll(".dv-controls button")
          .forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        closeCredits();
        render(mode);
      });
    });
  }

  function setup() {
    document
      .querySelectorAll<HTMLElement>('[data-component="track-bubbles"]')
      .forEach((root) => {
        if (root.dataset.initialized) return;
        root.dataset.initialized = "true";
        initTrackBubbles(root);
      });
  }

  // Astro's <ClientRouter /> swaps page content without a full reload, so a
  // script that only runs at parse time won't fire again after a client-side
  // navigation. astro:page-load fires on the initial load AND every swap.
  document.addEventListener("astro:page-load", setup);
</script>
