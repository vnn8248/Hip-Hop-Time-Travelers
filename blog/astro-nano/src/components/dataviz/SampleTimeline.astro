---
import "@styles/dataviz.css";

export interface Props {
  album: string;
}

const { album } = Astro.props;
---

<div class="dataviz not-prose" data-component="sample-timeline" data-album={album}>
  <div class="dv-controls" role="group" aria-label="Highlight by sample type">
    <button type="button" data-type="sampled">Sampled</button>
    <button type="button" data-type="was sampled in">Was Sampled In</button>
    <button type="button" data-type="remixed in">Remixed In</button>
    <button type="button" data-type="covered in">Covered In</button>
  </div>

  <div class="dv-legend"></div>

  <div class="dv-panel">
    <div class="dv-hint-wrap">
      <button type="button" class="dv-hint-toggle" aria-label="How to use this chart">?</button>
      <p class="dv-hint" role="tooltip">
        Each column is a track. Above the release row: what it sampled.
        Below: what later sampled, remixed, or covered it. Hover any dot to
        light up its track; click a release-row dot to zoom in with the
        full breakdown, or click any other dot for its own details. Click
        the background to reset.
      </p>
    </div>

    <svg class="dv-chart dv-timeline-chart" aria-label="Samples pulled from the past and songs influenced afterward, by track"></svg>

    <div class="dv-credits" hidden>
      <button type="button" class="dv-credits-close" aria-label="Close track details">&times;</button>
      <div class="dv-credits-body"></div>
    </div>
  </div>
  <div class="dv-tooltip" role="tooltip" hidden></div>
</div>

<script>
  import * as d3 from "d3";

  type SampleRecord = {
    track_name: string;
    track_number: number;
    sample_title: string;
    sample_artist: string;
    sample_year: number;
    direction: "sampled" | "was sampled in" | "remixed in" | "covered in";
    element: string;
    release_year: number;
  };

  type TrackMeta = {
    track_number: number;
    track_name: string;
    primary_producer: string;
    primary_mixer: string;
  };

  const PAST_DIRECTIONS = new Set(["sampled"]);
  // Fixed categorical order, anchored to the album-cover palette (brand sage
  // green first, matching "sampled" - what the track pulled from the past).
  const DIRECTION_COLOR: Record<string, string> = {
    sampled: "#597E5D",
    "was sampled in": "#4A8FD6",
    "remixed in": "#B87F1C",
    "covered in": "#29A67D",
  };
  const NO_DATA_LABEL = "No sample data available";

  const decadeOf = (year: number) => Math.floor(year / 10) * 10;
  const ANCHOR = Symbol("anchor");

  // The hint text only shows as a popover off the small "?" icon now (an
  // always-visible chip used to permanently cover real nodes in the top
  // row) - hover/focus reveal it via CSS alone; this just adds a
  // tap-to-toggle for touch, closing again on an outside tap.
  function setupHintToggle(root: HTMLElement) {
    const wrap = root.querySelector<HTMLDivElement>(".dv-hint-wrap");
    const toggle = wrap?.querySelector<HTMLButtonElement>(".dv-hint-toggle");
    if (!wrap || !toggle) return;
    toggle.addEventListener("click", (event) => {
      event.stopPropagation();
      wrap.classList.toggle("dv-hint-open");
      toggle.classList.add("dv-hint-seen"); // stop wobbling/glowing once noticed
    });
    document.addEventListener("click", (event) => {
      if (!wrap.contains(event.target as Node)) wrap.classList.remove("dv-hint-open");
    });
  }

  function initSampleTimeline(root: HTMLElement) {
    const album = root.dataset.album;
    const svgEl = root.querySelector<SVGSVGElement>(".dv-chart")!;
    const tooltipEl = root.querySelector<HTMLDivElement>(".dv-tooltip")!;
    // The blog post's <article> has a page-load entrance animation
    // (transform: translateY(...)) - any non-none transform on an ancestor
    // creates a new containing block for position:fixed descendants, so
    // this tooltip was never actually positioning relative to the
    // viewport, it was positioning relative to that <article>'s own box.
    // That's why it rendered somewhere real but consistently invisible.
    // Move it to <body> so it sits outside any transformed ancestor.
    document.body.appendChild(tooltipEl);
    const tooltip = d3.select(tooltipEl);
    setupHintToggle(root);

    Promise.all([
      fetch(`/data/${album}/output/album_data_viz_${album}.json`).then((res) => res.json()),
      fetch(`/data/${album}/output/samples_data_viz_${album}.json`).then((res) => res.json()),
    ])
      .then(([albumTracks, records]: [any[], SampleRecord[]]) => {
        const tracks: TrackMeta[] = albumTracks
          .map((t) => ({
            track_number: t.track_number,
            track_name: t.track_name,
            primary_producer: t.primary_producer || "Unknown",
            primary_mixer: t.primary_mixer || "Unknown",
          }))
          .sort((a, b) => a.track_number - b.track_number);
        render(tracks, records);
      })
      .catch((err) => {
        console.error(err);
        root.querySelector(".dv-panel")!.innerHTML =
          '<p class="dv-error">Couldn\'t load sample data.</p>';
      });

    function render(tracks: TrackMeta[], records: SampleRecord[]) {
      const releaseYear = records[0]?.release_year ?? d3.min(records, (d) => d.sample_year)!;

      const pastDecades = [
        ...new Set(
          records.filter((d) => PAST_DIRECTIONS.has(d.direction)).map((d) => decadeOf(d.sample_year)),
        ),
      ].sort((a, b) => a - b);
      const futureDecades = [
        ...new Set(
          records
            .filter((d) => !PAST_DIRECTIONS.has(d.direction))
            .map((d) => decadeOf(d.sample_year)),
        ),
      ].sort((a, b) => a - b);

      const rows: (number | typeof ANCHOR)[] = [...pastDecades, ANCHOR, ...futureDecades];
      const rowIndex = new Map(rows.map((r, i) => [r, i]));

      const colWidth = 70;
      const rowHeight = 64;
      const margin = { top: 16, right: 16, bottom: 40, left: 56 };
      const plotW = colWidth * tracks.length;
      const plotH = rowHeight * rows.length;
      const W = margin.left + plotW + margin.right;
      const H = margin.top + plotH + margin.bottom;

      const trackX = new Map(
        tracks.map((t, i) => [t.track_number, margin.left + colWidth * i + colWidth / 2]),
      );
      const rowY = (r: number | typeof ANCHOR) =>
        margin.top + (rowIndex.get(r) ?? 0) * rowHeight + rowHeight / 2;

      function nodeX(track_number: number, year: number) {
        const decade = decadeOf(year);
        const cx = trackX.get(track_number)!;
        const within = (year - decade) / 9 - 0.5; // -0.5..0.5 across the decade
        return cx + within * (colWidth * 0.7);
      }

      const svg = d3.select(svgEl).attr("viewBox", `0 0 ${W} ${H}`);
      svg.selectAll("*").remove();

      // Invisible full-size backdrop - clicking empty chart space resets
      // whatever track is currently focused, same as the panel's close (x).
      svg
        .append("rect")
        .attr("class", "dv-chart-bg-rect")
        .attr("x", 0)
        .attr("y", 0)
        .attr("width", W)
        .attr("height", H)
        .attr("fill", "transparent");

      // Decade row bands + gridlines, and the y-axis decade labels (a
      // separate sibling group so the labels can sit on their row's start
      // line rather than centered on it - both blur out together on focus).
      const rowsG = svg.append("g");
      const axisLabelsG = svg.append("g");
      // The very first row's own start (e.g. 1970 for a "1970s" row) has no
      // boundary line of its own otherwise - every other row's start is
      // already the row above it's bottom edge.
      rowsG
        .append("line")
        .attr("class", "dv-decade-gridline")
        .attr("x1", margin.left)
        .attr("x2", margin.left + plotW)
        .attr("y1", margin.top)
        .attr("y2", margin.top);
      rows.forEach((r) => {
        const y = rowY(r) - rowHeight / 2;
        const g = rowsG.append("g").attr("class", r === ANCHOR ? "dv-anchor-row" : null);
        g.append("rect")
          .attr("x", margin.left)
          .attr("y", y)
          .attr("width", plotW)
          .attr("height", rowHeight)
          .attr("fill", r === ANCHOR ? null : "none");
        g.append("line")
          .attr("class", "dv-decade-gridline")
          .attr("x1", margin.left)
          .attr("x2", margin.left + plotW)
          .attr("y1", y + rowHeight)
          .attr("y2", y + rowHeight);
        // Halfway through each decade row = the 5-year mark. The anchor row
        // is a single release year, not a decade span, so it gets none.
        if (r !== ANCHOR) {
          g.append("line")
            .attr("class", "dv-half-decade-gridline")
            .attr("x1", margin.left)
            .attr("x2", margin.left + plotW)
            .attr("y1", rowY(r))
            .attr("y2", rowY(r));
        }
        // Decade labels sit on their row's start (top) boundary - the solid
        // line - rather than centered on the dashed 5-year line. The anchor
        // row already names an exact year, so it stays centered. Skip the
        // decade whose span the release year itself falls in (e.g. "2000s"
        // right below "2000 · Release") - it's the same row already named.
        if (r === ANCHOR || r !== decadeOf(releaseYear)) {
          axisLabelsG
            .append("text")
            .attr("class", "dv-axis-label")
            .attr("x", margin.left - 10)
            .attr("y", r === ANCHOR ? rowY(r) : y)
            .attr("text-anchor", "end")
            .attr("dominant-baseline", "middle")
            .text(r === ANCHOR ? `${releaseYear} · Release` : `${r}s`);
        }
      });

      // Track column labels - dark by default so a full horizontal row of
      // them can overlap without reading as clutter; a label only lights up
      // (white) while its track is hovered or its details panel is open.
      const labelsG = svg.append("g");
      tracks.forEach((t) => {
        const cx = trackX.get(t.track_number)!;
        labelsG
          .append("text")
          .attr("class", "dv-track-label")
          .attr("data-track", t.track_number)
          .attr("x", cx)
          .attr("y", margin.top + plotH + 22)
          .attr("text-anchor", "middle")
          .text(t.track_name);
      });

      // Sample lineage - one <g> per track holding its stems, sample nodes,
      // and its own release-row anchor. Grouping them lets hover/click glow,
      // blur, and 3x-scale exactly one track's lineage without touching any
      // other track's markup.
      const plot = svg.append("g");
      const stacked = new Map<string, number>();
      const recordsByTrack = d3.group(records, (d) => d.track_number);
      const lineagePoints = new Map<number, { x: number; y: number }[]>();
      const creditsPanel = root.querySelector<HTMLDivElement>(".dv-credits")!;
      const creditsBody = creditsPanel.querySelector<HTMLDivElement>(".dv-credits-body")!;
      const creditsClose = root.querySelector<HTMLButtonElement>(".dv-credits-close")!;
      let activeTrackNumber: number | null = null;
      // A sample node glows while either condition holds: the cursor is
      // over it, or its click-opened info popup is the current one. Track
      // both separately and recompute on every change, so closing the
      // popup while still hovering doesn't flicker the glow off, and
      // leaving hover while the popup stays open doesn't turn it off either.
      let hoveredSampleEl: Element | null = null;
      let activeSampleEl: Element | null = null;

      function setLineageHover(trackNumber: number, on: boolean) {
        if (!on && activeTrackNumber === trackNumber) return; // stays lit while its panel is open
        plot
          .select<SVGGElement>(`.dv-track-lineage[data-track="${trackNumber}"]`)
          .classed("dv-lineage-hover", on);
        const label = labelsG.select<SVGTextElement>(
          `.dv-track-label[data-track="${trackNumber}"]`,
        );
        label.classed("dv-track-label-active", on);
        // SVG paints in DOM order, not by class/z-index - a still-dark label
        // appended after this one can otherwise paint over its now-white
        // glyphs wherever the two overlap. Bring it to the front so it's
        // always fully legible while lit.
        if (on) label.raise();
      }

      // Hovering (or having clicked open) one sample dot (a song that isn't
      // on this album) glows just that dot and the album track it's
      // connected to - not every other sample in that track's lineage,
      // unlike hovering the track's own node (which previews the whole
      // lineage via setLineageHover).
      function refreshSampleGlow(nodeEl: Element, trackNumber: number) {
        const on = hoveredSampleEl === nodeEl || activeSampleEl === nodeEl;
        d3.select(nodeEl).classed("dv-glow", on);
        const group = (nodeEl as SVGGraphicsElement).parentNode as SVGGElement;
        d3.select(group).select(".dv-node-track").classed("dv-glow", on);
        if (!on && activeTrackNumber === trackNumber) return; // stays lit while its panel is open
        const label = labelsG.select<SVGTextElement>(`.dv-track-label[data-track="${trackNumber}"]`);
        label.classed("dv-track-label-active", on);
        if (on) label.raise();
      }

      // Largest scale a track's lineage can take, anchored at its
      // release-row point, before any of its own nodes would spill past the
      // chart's edges - capped at 3x, but backed off below that whenever a
      // track's stems fan out far enough (many decades, heavy jitter) that
      // a full 3x would push nodes out of view.
      const MAX_FOCUS_SCALE = 3;
      const FOCUS_PADDING = 12;
      function computeFocusScale(trackNumber: number) {
        const cx = trackX.get(trackNumber)!;
        const cy = rowY(ANCHOR);
        const points = lineagePoints.get(trackNumber) ?? [];

        let scale = MAX_FOCUS_SCALE;
        for (const p of points) {
          const dx = p.x - cx;
          const dy = p.y - cy;
          if (dx > 0) scale = Math.min(scale, (W - FOCUS_PADDING - cx) / dx);
          if (dx < 0) scale = Math.min(scale, (cx - FOCUS_PADDING) / -dx);
          if (dy > 0) scale = Math.min(scale, (H - FOCUS_PADDING - cy) / dy);
          if (dy < 0) scale = Math.min(scale, (cy - FOCUS_PADDING) / -dy);
        }
        return Math.max(1, scale);
      }

      function focusTrack(trackNumber: number) {
        const cx = trackX.get(trackNumber)!;
        const cy = rowY(ANCHOR);
        const scale = computeFocusScale(trackNumber);

        plot.selectAll<SVGGElement, unknown>(".dv-track-lineage").each(function () {
          const isActive = this.getAttribute("data-track") === String(trackNumber);
          d3.select(this)
            .classed("dv-lineage-focus", isActive)
            .classed("dv-lineage-hover", isActive)
            .classed("dv-lineage-blurred", !isActive);
          if (isActive) {
            this.style.transformOrigin = `${cx}px ${cy}px`;
            this.style.transform = `scale(${scale})`;
            d3.select(this).raise();
          } else {
            this.style.transform = "";
          }
        });

        rowsG.classed("dv-lineage-blurred", true);
        // Every sample already gets its exact year printed in the details
        // panel, so the y-axis isn't pulling weight once that panel is
        // open - blur it along with the rest of the background rather than
        // carve out an exception that the panel (which can sit on either
        // side) would inconsistently cover anyway.
        axisLabelsG.classed("dv-lineage-blurred", true);
        labelsG.selectAll<SVGTextElement, unknown>(".dv-track-label").each(function () {
          const isActive = this.getAttribute("data-track") === String(trackNumber);
          d3.select(this)
            .classed("dv-track-label-active", isActive)
            .classed("dv-lineage-blurred", !isActive);
          if (isActive) d3.select(this).raise();
        });
      }

      function unfocusAll() {
        plot
          .selectAll<SVGGElement, unknown>(".dv-track-lineage")
          .classed("dv-lineage-focus", false)
          .classed("dv-lineage-hover", false)
          .classed("dv-lineage-blurred", false)
          .each(function () {
            this.style.transform = "";
          });
        plot.selectAll(".dv-node-track").classed("dv-node-active", false);
        rowsG.classed("dv-lineage-blurred", false);
        axisLabelsG.classed("dv-lineage-blurred", false);
        labelsG
          .selectAll(".dv-track-label")
          .classed("dv-track-label-active", false)
          .classed("dv-lineage-blurred", false);
      }

      function renderDetails(track: TrackMeta) {
        const trackRecords = recordsByTrack.get(track.track_number) ?? [];
        const sampled = trackRecords.filter((r) => PAST_DIRECTIONS.has(r.direction));
        const influence = trackRecords.filter((r) => !PAST_DIRECTIONS.has(r.direction));
        const influenceCounts = d3.rollups(
          influence,
          (v) => v.length,
          (d) => d.direction,
        );

        // Same color each sample type's control button uses, so a scan down
        // the details list reads against the same key as the chart itself.
        const typeAttrs = (direction: string) =>
          `class="dv-type-item" style="background:${DIRECTION_COLOR[direction] ?? "#5B564A"}"`;
        const sampleItem = (s: SampleRecord) =>
          `<li ${typeAttrs(s.direction)}><b>${s.sample_title}</b><br><span class="dv-role-detail">${s.sample_artist} · ${s.sample_year} · ${s.element}</span></li>`;
        const influenceItem = (s: SampleRecord) =>
          `<li ${typeAttrs(s.direction)}><b>${s.sample_title}</b><br><span class="dv-role-detail">${s.sample_artist} · ${s.sample_year} · ${s.direction} · ${s.element}</span></li>`;

        let html = `<p class="dv-credits-title">${track.track_name}</p>`;

        html += `<h4>Producer</h4><ul><li>${track.primary_producer}</li></ul>`;
        html += `<h4>Mixer</h4><ul><li>${track.primary_mixer}</li></ul>`;

        html += `<h4>Samples</h4>`;
        html += `<p class="dv-credits-count">${sampled.length} song${sampled.length === 1 ? "" : "s"} sampled</p>`;
        if (sampled.length) {
          html += `<ul>${sampled.map(sampleItem).join("")}</ul>`;
        }

        html += `<h4>Influence</h4>`;
        if (influenceCounts.length) {
          html += `<p class="dv-credits-count">${influenceCounts
            .map(([direction, count]) => `${count} ${direction}`)
            .join(" · ")}</p>`;
          html += `<ul>${influence.map(influenceItem).join("")}</ul>`;
        } else {
          html += `<p class="dv-empty">Nothing has sampled, remixed, or covered this track yet.</p>`;
        }

        creditsBody.innerHTML = html;
        creditsPanel.hidden = false;
        creditsPanel.scrollTop = 0; // start at the top for every new track, not wherever the last one left off
        // The panel defaults to the right side, which otherwise sits right
        // on top of a focus-zoomed track from the right half of the chart
        // (the last track most of all). Flip it to the left for those.
        const cx = trackX.get(track.track_number)!;
        creditsPanel.classList.toggle("dv-credits-left", cx > margin.left + plotW / 2);
      }

      function closeDetails() {
        creditsPanel.hidden = true;
        unfocusAll();
        activeTrackNumber = null;
        hideSampleInfo();
      }

      function toggleDetails(track: TrackMeta) {
        hideSampleInfo();
        if (activeTrackNumber === track.track_number) {
          closeDetails();
          return;
        }
        activeTrackNumber = track.track_number;
        renderDetails(track);
        focusTrack(track.track_number);
        plot.selectAll(".dv-node-track").classed("dv-node-active", false);
        plot
          .select(`.dv-track-lineage[data-track="${track.track_number}"] .dv-node-track`)
          .classed("dv-node-active", true);
      }

      // Click, not hover, for the same info a sample node would otherwise
      // show - mousemove/mouseenter tooltips on nodes this small have
      // repeatedly failed to appear for real users on this chart, while
      // click (used for the track panel above) has been confirmed to work.
      function hideSampleInfo() {
        const el = activeSampleEl;
        activeSampleEl = null;
        tooltip.attr("hidden", true);
        // Clear the glow it was holding open, unless the cursor is still
        // actually over it (refreshSampleGlow re-checks hoveredSampleEl).
        if (el) refreshSampleGlow(el, Number(el.getAttribute("data-track")));
      }

      function showSampleInfo(el: Element, event: MouseEvent, d: SampleRecord) {
        closeDetails(); // only one info surface open at a time
        activeSampleEl = el;
        refreshSampleGlow(el, d.track_number);
        tooltip
          .style("left", event.clientX + 14 + "px")
          .style("top", event.clientY + 14 + "px")
          .html(
            `${d.track_name}<br><span class="dv-tooltip-type" style="background:${DIRECTION_COLOR[d.direction] ?? "#5B564A"}">${d.direction}</span><br>${d.sample_year}<br>${d.sample_title}<br>by ${d.sample_artist}`,
          )
          .attr("hidden", null);
      }

      function toggleSampleInfo(el: Element, event: MouseEvent, d: SampleRecord) {
        if (activeSampleEl === el) {
          hideSampleInfo();
          return;
        }
        showSampleInfo(el, event, d);
      }

      creditsClose.addEventListener("click", closeDetails);
      svg.select(".dv-chart-bg-rect").on("click", closeDetails);

      tracks.forEach((t) => {
        const trackRecords = recordsByTrack.get(t.track_number) ?? [];
        const trackHasData = trackRecords.length > 0;
        const g = plot
          .append("g")
          .attr("class", "dv-track-lineage")
          .attr("data-track", t.track_number);

        trackRecords.forEach((d) => {
          const trackCenter = trackX.get(d.track_number)!;
          const anchorY = rowY(ANCHOR);
          const decade = decadeOf(d.sample_year);
          const x = nodeX(d.track_number, d.sample_year);
          let y = rowY(decade);

          // stagger exact duplicates (same track, same year) so they stay visible
          const stackKey = `${d.track_number}-${d.sample_year}`;
          const n = stacked.get(stackKey) ?? 0;
          stacked.set(stackKey, n + 1);
          const JITTER = [0, -9, 9, -18, 18, -27, 27];
          y += JITTER[n % JITTER.length];

          if (!lineagePoints.has(t.track_number)) lineagePoints.set(t.track_number, []);
          lineagePoints.get(t.track_number)!.push({ x, y });

          const color = DIRECTION_COLOR[d.direction] ?? "#5B564A";

          g.append("path")
            .attr("class", "dv-stem")
            .attr("data-direction", d.direction)
            .attr("data-track", d.track_number)
            .attr("stroke", color)
            .attr("stroke-opacity", 0.75)
            .attr("d", `M${trackCenter},${anchorY} L${x},${y}`);

          g.append("circle")
            .attr("class", "dv-node dv-node-sample")
            .attr("data-direction", d.direction)
            .attr("data-track", d.track_number)
            .attr("cx", x)
            .attr("cy", y)
            .attr("r", 4.5)
            .attr("fill", color)
            .on("mouseenter", (event) => {
              hoveredSampleEl = event.currentTarget as Element;
              refreshSampleGlow(event.currentTarget as Element, t.track_number);
            })
            .on("mouseleave", (event) => {
              hoveredSampleEl = null;
              refreshSampleGlow(event.currentTarget as Element, t.track_number);
            })
            .on("click", (event) => {
              event.stopPropagation();
              toggleSampleInfo(event.currentTarget as Element, event, d);
            });
        });

        // the track's own node at the release row - hollow/dashed if
        // whosampled.com had nothing recorded for it, so it still shows up.
        g.append("circle")
          .attr(
            "class",
            trackHasData ? "dv-node dv-node-track" : "dv-node dv-node-track dv-node-nodata",
          )
          .attr("data-track", t.track_number)
          .attr("cx", trackX.get(t.track_number)!)
          .attr("cy", rowY(ANCHOR))
          .attr("r", trackHasData ? 7 : 6)
          .attr("fill", trackHasData ? "#FFFFFF" : "none")
          .on("mouseenter", () => setLineageHover(t.track_number, true))
          .on("mouseleave", () => setLineageHover(t.track_number, false))
          .on("click", (event) => {
            event.stopPropagation();
            toggleDetails(t);
          });
      });

      renderLegend();
      setupControls(plot, records);
    }

    function setupControls(plot: d3.Selection<SVGGElement, unknown, null, undefined>, records: SampleRecord[]) {
      const buttons = root.querySelectorAll<HTMLButtonElement>(".dv-controls button[data-type]");
      let activeType: string | null = null;

      buttons.forEach((btn) => {
        const color = DIRECTION_COLOR[btn.dataset.type!];
        if (color) btn.style.setProperty("--dv-type-color", color);
      });

      function applyTypeFilter(type: string | null) {
        activeType = type;

        const tracksWithType = new Set(
          type === null ? [] : records.filter((d) => d.direction === type).map((d) => d.track_number),
        );

        plot.selectAll<SVGPathElement, unknown>(".dv-stem").each(function () {
          const dir = this.getAttribute("data-direction");
          const match = type === null || dir === type;
          d3.select(this).classed("dv-dim", type !== null && !match);
        });

        plot.selectAll<SVGCircleElement, unknown>(".dv-node-sample").each(function () {
          const dir = this.getAttribute("data-direction");
          const match = type === null || dir === type;
          d3.select(this)
            .classed("dv-dim", type !== null && !match)
            .classed("dv-glow", type !== null && match);
        });

        plot.selectAll<SVGCircleElement, unknown>(".dv-node-track").each(function () {
          const trackNumber = Number(this.getAttribute("data-track"));
          const match = type === null || tracksWithType.has(trackNumber);
          d3.select(this)
            .classed("dv-dim", type !== null && !match)
            .classed("dv-glow", type !== null && match);
        });

        buttons.forEach((btn) => {
          btn.classList.toggle("active", btn.dataset.type === type);
        });
      }

      buttons.forEach((btn) => {
        btn.addEventListener("click", () => {
          const type = btn.dataset.type!;
          applyTypeFilter(activeType === type ? null : type);
        });
      });
    }

    function renderLegend() {
      // The direction colors are already previewed on the control buttons
      // themselves (hover/active), so the legend only needs to explain the
      // one thing those buttons don't: the hollow "no data" marker.
      const legend = root.querySelector<HTMLDivElement>(".dv-legend")!;
      legend.innerHTML = "";
      const noDataItem = document.createElement("span");
      const noDataSwatch = document.createElement("span");
      noDataSwatch.className = "dv-swatch dv-swatch-hollow";
      noDataItem.appendChild(noDataSwatch);
      noDataItem.append(NO_DATA_LABEL);
      legend.appendChild(noDataItem);
    }
  }

  function setup() {
    document
      .querySelectorAll<HTMLElement>('[data-component="sample-timeline"]')
      .forEach((root) => {
        if (root.dataset.initialized) return;
        root.dataset.initialized = "true";
        initSampleTimeline(root);
      });
  }

  // Astro's <ClientRouter /> swaps page content without a full reload, so a
  // script that only runs at parse time won't fire again after a client-side
  // navigation. astro:page-load fires on the initial load AND every swap.
  document.addEventListener("astro:page-load", setup);
</script>
