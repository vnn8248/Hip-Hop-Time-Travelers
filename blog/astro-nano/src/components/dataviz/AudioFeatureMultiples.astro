---
import "@styles/dataviz.css";

export interface Props {
  album: string;
}

const { album } = Astro.props;
---

<div class="dataviz not-prose" data-component="audio-feature-multiples" data-album={album}>
  <div class="dv-legend"></div>
  <div class="dv-panel">
    <svg class="dv-chart" aria-label="Energy, danceability, valence, and tempo across the tracklist"></svg>
  </div>
</div>

<script>
  import * as d3 from "d3";

  type Track = {
    name: string;
    energy: number;
    dance: number;
    valence: number;
    tempo: number;
  };

  // Fixed categorical order, shared with the site's --dv-series-* palette
  // (album-cover brand green first) so a color means the same thing across
  // all three charts on the page.
  const FEATURES: { key: keyof Track; label: string; color: string }[] = [
    { key: "energy", label: "Energy", color: "#597E5D" },
    { key: "dance", label: "Danceability", color: "#4A8FD6" },
    { key: "valence", label: "Valence", color: "#B87F1C" },
    { key: "tempo", label: "Tempo", color: "#29A67D" },
  ];

  // Energy/danceability/valence are already 0-1. Tempo is raw BPM, so put
  // it on that same axis by dividing by 100 - 100 BPM reads as 1.0, 150 as
  // 1.5, and so on - instead of giving it its own separate scale.
  function value(t: Track, key: keyof Track): number {
    return key === "tempo" ? (t.tempo as number) / 100 : (t[key] as number);
  }

  function initAudioFeatureMultiples(root: HTMLElement) {
    const album = root.dataset.album;
    const svgEl = root.querySelector<SVGSVGElement>(".dv-chart")!;
    const legendEl = root.querySelector<HTMLDivElement>(".dv-legend")!;

    fetch(`/data/${album}/output/album_data_viz_${album}.json`)
      .then((res) => res.json())
      .then((recs) => {
        const tracks: Track[] = recs
          .slice()
          .sort((a: any, b: any) => a.track_number - b.track_number)
          .map((d: any) => ({
            name: d.track_name,
            energy: d.audio_features.energy,
            dance: d.audio_features.danceability,
            valence: d.audio_features.valence,
            tempo: d.audio_features.tempo,
          }));

        renderLegend();
        render(tracks);
      })
      .catch((err) => {
        console.error(err);
        root.querySelector(".dv-panel")!.innerHTML =
          '<p class="dv-error">Couldn\'t load audio-feature data.</p>';
      });

    function render(tracks: Track[]) {
      const w = Math.max(480, tracks.length * 40);
      const chartH = 320;
      const labelH = 40;
      const h = chartH + labelH;
      const m = { t: 16, r: 16, b: 6, l: 46 };

      const svg = d3.select(svgEl).attr("viewBox", `0 0 ${w} ${h}`);
      svg.selectAll("*").remove();

      const x = d3
        .scalePoint()
        .domain(tracks.map((_d, i) => String(i)))
        .range([m.l, w - m.r]);

      const allValues = FEATURES.flatMap((f) => tracks.map((t) => value(t, f.key)));
      const y = d3
        .scaleLinear()
        .domain([0, d3.max(allValues) ?? 1])
        .nice()
        .range([chartH - m.b, m.t]);

      svg
        .append("g")
        .attr("class", "dv-axis")
        .attr("transform", `translate(${m.l},0)`)
        .call(d3.axisLeft(y).ticks(5));

      // Track column labels - dark by default (same as SampleTimeline's) so
      // a full horizontal row of them can overlap without reading as
      // clutter; a label only lights up (white) while its column is
      // hovered, via the song nodes below. Full track titles run much
      // longer than SampleTimeline's, so a column near either edge would
      // otherwise center its label half off the chart - measure each one
      // (at the smaller size it renders at once active) and anchor it to
      // start/end instead of middle wherever that would happen.
      const labelsG = svg.append("g");
      tracks.forEach((t, i) => {
        const cx = x(String(i))!;
        const label = labelsG
          .append("text")
          .attr("class", "dv-track-label")
          .attr("data-track", i)
          .attr("x", cx)
          .attr("y", chartH + 22)
          .attr("text-anchor", "middle")
          .text(t.name);

        label.classed("dv-track-label-active", true);
        const halfWidth = (label.node() as SVGTextElement).getComputedTextLength() / 2;
        label.classed("dv-track-label-active", false);

        const PAD = 4;
        if (cx - halfWidth < PAD) {
          label.attr("text-anchor", "start").attr("x", PAD);
        } else if (cx + halfWidth > w - PAD) {
          label.attr("text-anchor", "end").attr("x", w - PAD);
        }
      });

      function setTrackLabelHover(i: number, on: boolean) {
        const label = labelsG.select<SVGTextElement>(`.dv-track-label[data-track="${i}"]`);
        label.classed("dv-track-label-active", on);
        if (on) label.raise();
      }

      FEATURES.forEach((f) => {
        const line = d3
          .line<Track>()
          .x((_d, i) => x(String(i))!)
          .y((d) => y(value(d, f.key)))
          .curve(d3.curveMonotoneX);

        svg
          .append("path")
          .datum(tracks)
          .attr("d", line)
          .attr("fill", "none")
          .attr("stroke", f.color)
          .attr("stroke-width", 2);

        svg
          .selectAll(`circle.dv-point-${f.key}`)
          .data(tracks)
          .enter()
          .append("circle")
          .attr("class", `dv-point-${f.key}`)
          .attr("data-track", (_d, i) => i)
          .attr("cx", (_d, i) => x(String(i))!)
          .attr("cy", (d) => y(value(d, f.key)))
          .attr("r", 3)
          .attr("fill", f.color)
          .on("mouseenter", (event) => {
            setTrackLabelHover(Number(event.currentTarget.getAttribute("data-track")), true);
          })
          .on("mouseleave", (event) => {
            setTrackLabelHover(Number(event.currentTarget.getAttribute("data-track")), false);
          })
          .append("title")
          .text(
            (d) =>
              `${d.name} — ${f.label}: ${f.key === "tempo" ? `${Math.round(d.tempo)} BPM` : d[f.key]}`,
          );
      });
    }

    function renderLegend() {
      legendEl.innerHTML = "";
      FEATURES.forEach((f) => {
        const item = document.createElement("span");
        const swatch = document.createElement("span");
        swatch.className = "dv-swatch";
        swatch.style.background = f.color;
        item.appendChild(swatch);
        item.append(f.label);
        legendEl.appendChild(item);
      });
    }
  }

  function setup() {
    document
      .querySelectorAll<HTMLElement>('[data-component="audio-feature-multiples"]')
      .forEach((root) => {
        if (root.dataset.initialized) return;
        root.dataset.initialized = "true";
        initAudioFeatureMultiples(root);
      });
  }

  // Astro's <ClientRouter /> swaps page content without a full reload, so a
  // script that only runs at parse time won't fire again after a client-side
  // navigation. astro:page-load fires on the initial load AND every swap.
  document.addEventListener("astro:page-load", setup);
</script>
