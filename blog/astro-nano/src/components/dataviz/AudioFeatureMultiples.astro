---
import "@styles/dataviz.css";

export interface Props {
  album: string;
}

const { album } = Astro.props;
---

<div class="dataviz not-prose" data-component="audio-feature-multiples" data-album={album}>
  <div class="dv-panel dv-carousel-panel">
    <button type="button" class="dv-carousel-nav dv-carousel-prev" aria-label="Previous feature">&lsaquo;</button>
    <div class="dv-carousel-chart">
      <p class="dv-sm-title"></p>
      <svg class="dv-chart" aria-label="Audio feature across the tracklist"></svg>
    </div>
    <button type="button" class="dv-carousel-nav dv-carousel-next" aria-label="Next feature">&rsaquo;</button>
  </div>
  <div class="dv-carousel-dots"></div>
</div>

<script>
  import * as d3 from "d3";

  type Track = {
    name: string;
    energy: number;
    dance: number;
    valence: number;
    tempo: number;
  };

  const FEATURES: { key: keyof Track; label: string }[] = [
    { key: "energy", label: "Energy" },
    { key: "dance", label: "Danceability" },
    { key: "valence", label: "Valence" },
    { key: "tempo", label: "Tempo (BPM)" },
  ];

  function initAudioFeatureMultiples(root: HTMLElement) {
    const album = root.dataset.album;
    const svgEl = root.querySelector<SVGSVGElement>(".dv-chart")!;
    const titleEl = root.querySelector<HTMLParagraphElement>(".dv-sm-title")!;
    const dotsEl = root.querySelector<HTMLDivElement>(".dv-carousel-dots")!;
    const prevBtn = root.querySelector<HTMLButtonElement>(".dv-carousel-prev")!;
    const nextBtn = root.querySelector<HTMLButtonElement>(".dv-carousel-next")!;

    let tracks: Track[] = [];
    let index = 0;

    fetch(`/data/${album}/output/album_data_viz_${album}.json`)
      .then((res) => res.json())
      .then((recs) => {
        tracks = recs
          .slice()
          .sort((a: any, b: any) => a.track_number - b.track_number)
          .map((d: any) => ({
            name: d.track_name,
            energy: d.audio_features.energy,
            dance: d.audio_features.danceability,
            valence: d.audio_features.valence,
            tempo: d.audio_features.tempo,
          }));

        renderDots();
        renderSlide(index);
      })
      .catch((err) => {
        console.error(err);
        root.querySelector(".dv-panel")!.innerHTML =
          '<p class="dv-error">Couldn\'t load audio-feature data.</p>';
      });

    function renderSlide(i: number) {
      index = ((i % FEATURES.length) + FEATURES.length) % FEATURES.length;
      const f = FEATURES[index];
      titleEl.textContent = f.label;

      const w = Math.max(480, tracks.length * 40);
      const chartH = 320;
      const labelH = 70;
      const h = chartH + labelH;
      const m = { t: 16, r: 16, b: 6, l: 46 };

      const svg = d3.select(svgEl).attr("viewBox", `0 0 ${w} ${h}`);
      svg.selectAll("*").remove();

      const x = d3
        .scalePoint()
        .domain(tracks.map((_d, i2) => String(i2)))
        .range([m.l, w - m.r]);
      const yDomain =
        f.key === "tempo" ? (d3.extent(tracks, (d) => d.tempo) as [number, number]) : [0, 1];
      const y = d3.scaleLinear().domain(yDomain).nice().range([chartH - m.b, m.t]);

      svg
        .append("g")
        .attr("class", "dv-axis")
        .attr("transform", `translate(${m.l},0)`)
        .call(d3.axisLeft(y).ticks(5));

      const line = d3
        .line<Track>()
        .x((_d, i2) => x(String(i2))!)
        .y((d) => y(d[f.key] as number))
        .curve(d3.curveMonotoneX);

      svg
        .append("path")
        .datum(tracks)
        .attr("d", line)
        .attr("fill", "none")
        .attr("stroke", "#597E5D")
        .attr("stroke-width", 2);

      svg
        .selectAll("circle")
        .data(tracks)
        .enter()
        .append("circle")
        .attr("cx", (_d, i2) => x(String(i2))!)
        .attr("cy", (d) => y(d[f.key] as number))
        .attr("r", 3)
        .attr("fill", "#FFFFFF")
        .append("title")
        .text((d) => `${d.name}: ${d[f.key]}`);

      svg
        .selectAll("text.dv-track-label")
        .data(tracks)
        .enter()
        .append("text")
        .attr("class", "dv-track-label")
        .attr("text-anchor", "end")
        .attr("transform", (_d, i2) => `translate(${x(String(i2))},${chartH + 12}) rotate(-40)`)
        .text((d) => d.name);

      renderDots();
    }

    function renderDots() {
      dotsEl.innerHTML = "";
      FEATURES.forEach((f, i) => {
        const dot = document.createElement("button");
        dot.type = "button";
        dot.className = "dv-carousel-dot" + (i === index ? " active" : "");
        dot.setAttribute("aria-label", f.label);
        dot.addEventListener("click", () => renderSlide(i));
        dotsEl.appendChild(dot);
      });
    }

    prevBtn.addEventListener("click", () => renderSlide(index - 1));
    nextBtn.addEventListener("click", () => renderSlide(index + 1));
  }

  function setup() {
    document
      .querySelectorAll<HTMLElement>('[data-component="audio-feature-multiples"]')
      .forEach((root) => {
        if (root.dataset.initialized) return;
        root.dataset.initialized = "true";
        initAudioFeatureMultiples(root);
      });
  }

  // Astro's <ClientRouter /> swaps page content without a full reload, so a
  // script that only runs at parse time won't fire again after a client-side
  // navigation. astro:page-load fires on the initial load AND every swap.
  document.addEventListener("astro:page-load", setup);
</script>
