---
import { getCollection } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import ArrowCard from "@components/ArrowCard.astro";
import Link from "@components/Link.astro";
import { SITE, HOME, SOCIALS } from "@consts";

const blog = (await getCollection("blog"))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0,SITE.NUM_POSTS_ON_HOMEPAGE);
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <h4 class="animate font-semibold text-black dark:text-white">
      Welcome To The Crew
    </h4>
    <div class="space-y-16">
      <section>
        <article class="space-y-4">
          <p class="animate">
            We've been expecting you.
          </p>
          <p class="animate">
            We are the Hip-Hop Time Travelers. We are a team that studies one of the most amazing forms of music to have ever been created: Hip-Hop. Its universe is vast and continuously expanding, forming new material every day while distant relics remain timeless. 
          </p>
          <p class="animate">
            As a new crew member you've been given the unique capability to explore any time you want in the Hip-Hop universe. Your mission is to immerse yourself with an album of choice and come back with a report on why this time, artist, verse, or piece of musical art was special and how other worlds and cultures have changed since then, or not.
          </p>
          <p class="animate">
            Each report pairs a write-up with data visualizations pulled straight from the source: who
            produced and mixed every track, what got sampled and what it went on to
            influence, and how the album's vibes move from song to song.
          </p>
          <p class="animate">
            Choose your tools: a record player, a sound system, a pair of headphones; a pen, a pad, your favorite hat. You know what suits you best.
          </p>
          <p class="animate">
            We'll see you when you get back.
          </p>
        </article>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black dark:text-white">
            Latest Reports
          </h5>
          <Link href="/blog">
            See all posts
          </Link>
        </div>
        <ul class="flex flex-col gap-4">
          {blog.map(post => (
            <li>
              <ArrowCard entry={post} />
            </li>
          ))}
        </ul>
      </section>

      <section class="animate space-y-4">
        <h5 class="font-semibold text-black dark:text-white">
          Let's Connect
        </h5>
        <article>
          <p>
            Want to report on an album, have an idea for a new data viz, or just want to say what's up? Send us an email.
          </p>
          <div class="not-prose flex items-center gap-2">
            <img src="/favicon.webp" alt="" width="24" height="24" />
            <Link href={`mailto:${SITE.EMAIL}`} aria-label={`Email ${SITE.NAME}`}>
              {SITE.EMAIL}
            </Link>
          </div>
        </article>
        <h5 class="font-semibold text-black dark:text-white">
          The Methods
        </h5>
        <article>
          <p class="animate">
            All data sources, pipelines, and visualizations behind these reports are
            <Link href="https://github.com/vnn8248/Hip-Hop-Time-Travelers" aria-label={`${SITE.NAME} on Github`} external>
              open on Github
            </Link>.
          </p>
        </article>
      </section>
    </div>
  </Container>
</PageLayout>
