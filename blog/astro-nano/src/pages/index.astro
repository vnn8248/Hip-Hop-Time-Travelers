---
import { getCollection } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import ArrowCard from "@components/ArrowCard.astro";
import Link from "@components/Link.astro";
import { SITE, HOME, SOCIALS } from "@consts";

const blog = (await getCollection("blog"))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0,SITE.NUM_POSTS_ON_HOMEPAGE);
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <h4 class="animate font-semibold text-black dark:text-white">
      Welcome To Hip-Hop Time Travelers <span class="text-xl">🎧</span>
    </h4>
    <div class="space-y-16">
      <section>
        <article class="space-y-4">
          <p class="animate">
            This is a blog for 90's Hip-Hop fans who love discovering new, old music. We're the old heads (even if we're 30 something years old). Music that is "new to me" but has been released for years. Times are busy but whenever we finally make the time to sit a listen to a full album, it's a feeling like no other, Because 90's Hip-Hop, is a rabbit-hole like no other. It's the Golden Era, it's evergreen, and it's timeless.
          </p>
          <p class="animate">
            Each post pairs the write-up with data pulled straight from the source: who
            produced and mixed every track, what got sampled and what it went on to
            influence, and how the album's energy, danceability, valence, and tempo move
            from song to song.
          </p>
          <p class="animate">
            The data pipeline and visualizations behind these posts are
            <Link href="https://github.com/vnn8248/Hip-Hop-Time-Travelers" aria-label={`${SITE.NAME} on Github`} external>
              open on Github
            </Link>.
          </p>
        </article>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black dark:text-white">
            Latest posts
          </h5>
          <Link href="/blog">
            See all posts
          </Link>
        </div>
        <ul class="flex flex-col gap-4">
          {blog.map(post => (
            <li>
              <ArrowCard entry={post} />
            </li>
          ))}
        </ul>
      </section>

      <section class="animate space-y-4">
        <h5 class="font-semibold text-black dark:text-white">
          Let's Connect
        </h5>
        <article>
          <p>
            If you want to get in touch about something or just to say hi,
            reach out on social media or send us an email.
          </p>
        </article>
        <ul class="flex flex-wrap gap-2">
          {SOCIALS.map(SOCIAL => (
            <li class="flex gap-x-2 text-nowrap">
              <Link href={SOCIAL.HREF} external aria-label={`${SITE.NAME} on ${SOCIAL.NAME}`}>
                {SOCIAL.NAME}
              </Link>
              {"/"}
            </li>
          ))}
          <li class="line-clamp-1">
            <Link href={`mailto:${SITE.EMAIL}`} aria-label={`Email ${SITE.NAME}`}>
              {SITE.EMAIL}
            </Link>
          </li>
        </ul>
      </section>
    </div>
  </Container>
</PageLayout>
